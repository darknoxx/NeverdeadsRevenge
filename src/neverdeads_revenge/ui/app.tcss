/* Neverdead's Revenge -- visual theme.
   Dark, cold and readable at a glance: the dungeon should feel like a place you
   are looking into, not a page of text.

   Only real Textual design tokens are used here (accent, background, border,
   error, foreground, panel, primary, secondary, success, surface, text,
   warning). Dimmed text uses literal greys, because there is no muted/dim token. */

Screen {
    background: $background;
    color: $foreground;
}

/* -- title ------------------------------------------------------------- */

#title-screen {
    align: center middle;
    height: 1fr;
}

#title-art {
    width: 1fr;
    content-align: center middle;
    color: $accent;
    text-style: bold;
}

#title-subtitle {
    width: 1fr;
    content-align: center middle;
    color: #8f8f8f;
}

#title-hint {
    width: 1fr;
    content-align: center middle;
    color: #6b6b6b;
}

/* Blank unless a run is waiting to be picked up. */
#title-saved {
    width: 1fr;
    height: auto;
    content-align: center middle;
    color: $accent;
}

/* Blank until there has been a run, so it is styled but usually empty. */
#title-best {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: $accent;
}

/* -- hero select ------------------------------------------------------- */

/* Everything on one axis, centred both ways: the letter, the name, the prose
   and the numbers. Three separate blocks with three different left edges was
   what this screen was, and the prose sat against the left wall.

   A container rather than align-h on the screen: Textual ignores horizontal
   alignment on a Screen itself. */
#hero-select {
    align: center middle;
    width: 1fr;
    height: 1fr;
}

/* Exactly as wide as the stat block, which is the widest thing in it: the prose
   wraps to this, the numbers fill it, and both start on the same column. A wider
   card centred the numbers in the middle of a column of prose with a different
   left edge, and the eye reads that as two blocks that failed to line up. */
#hero-card {
    width: 42;
    height: auto;
}

/* The hero's letter at the size the title spells its own name in. Five wide,
   so the column below it is what decides the layout, not this. */
#hero-art {
    width: 1fr;
    height: auto;
    content-align: center middle;
}

#hero-name {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    text-align: center;
}

/* A fixed five rows, which is what the longest blurb in the roster needs. The
   card would otherwise grow and shrink as the player cycles, and everything
   below the prose -- the numbers, the roster -- would move with it.
   tests/test_ui.py asserts that every hero still fits. */
#hero-blurb {
    width: 1fr;
    height: 5;
    margin: 1 0 0 0;
}

/* Eight, matching STAT_ROWS in hero_select.py. Fixed, because a locked slot has
   no table to show at all and the card has to be the same height on every slot. */
#hero-stats {
    width: 1fr;
    height: 8;
    margin: 1 0 0 0;
}

#hero-roster {
    width: 1fr;
    height: auto;
    margin: 2 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}


/* -- game screen ------------------------------------------------------- */

#game-screen {
    layout: horizontal;
}

/* The map column: the map, then the row the log and the marks share. */
#main {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

#map-view {
    width: 1fr;
    height: 1fr;
    border: round $panel;
    padding: 0 1;
}

#sidebar {
    /* Wide enough for the longest legend line: "skeleton even 28hp 6-12d". */
    width: 34;
    height: 1fr;
    border: round $panel;
    padding: 0 1;
    layout: vertical;
}

/* The log sits under the map, full width, at a fixed height. The map above it
   takes whatever is left, which is why the legend lives in the sidebar instead
   of beside the log: a bottom-row legend leaves the map about ten rows to work
   with, and the map is the thing that needs the rows.

   Six, not seven: the legend gained the chest row and the sidebar needed the
   line back. The log still shows the last four messages, which is what a fight
   needs. */
/* The log and the panel that says what is on you, side by side. The row is
   taller than the log alone was, because the panel needs the height more than
   the log needs the width -- a message is a sentence, and the log was printing
   them into half a screen of nothing. */
#bottom {
    height: 9;
}

/* The curses and the gifts, beside the log. Names only, so the columns are
   narrow and the log keeps the rest. The widths are mirrored by ``CURSES_WIDTH``
   and ``MARKS_WIDTH`` in ``widgets/marks.py``, where the reason for each is
   written down. */
#curses {
    width: 16;
}

#marks {
    width: 22;
}

#message-log {
    width: 1fr;
    height: 1fr;
    min-height: 4;
    border: round $panel;
    padding: 0 1;
    background: $surface;
    /* No scrollbar. It is a tail view -- the newest lines, auto-scrolled -- and
       the keys belong to the game, so a bar implying you can scroll it is a
       decoration that only invites the question of what it is for. */
    scrollbar-size-vertical: 0;
}

/* -- help ---------------------------------------------------------------- */

HelpScreen {
    align: center middle;
    background: $background 70%;
}

#help {
    width: 76;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $panel;
    background: $surface;
}

#help-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    text-style: bold;
    color: $accent;
}

#help-body {
    width: 1fr;
    height: auto;
    color: $foreground;
}

#help-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- character sheet ----------------------------------------------------- */

CharacterScreen {
    align: center middle;
    background: $background 70%;
}

#character {
    width: 60;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $panel;
    background: $surface;
}

#character-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    text-style: bold;
    color: $accent;
}

#character-body {
    width: 1fr;
    height: auto;
    color: $foreground;
}

#character-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- name entry / scoreboard --------------------------------------------- */

NameEntryScreen, ScoreboardScreen {
    align: center middle;
    background: $background 70%;
}

#name-entry {
    width: 44;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#name-entry-title {
    width: 1fr;
    height: auto;
    content-align: center middle;
    text-style: bold;
    color: $accent;
}

#name-entry-score {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    content-align: center middle;
    color: #8f8f8f;
}

#name-entry-slots {
    width: 1fr;
    height: auto;
    margin: 1 0 1 0;
    content-align: center middle;
    text-style: bold;
}

#name-entry-hint {
    width: 1fr;
    height: auto;
    content-align: center middle;
    color: #6b6b6b;
}

#scoreboard {
    width: 60;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $panel;
    background: $surface;
}

#scoreboard-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    text-style: bold;
    color: $accent;
}

#scoreboard-body {
    width: 1fr;
    height: auto;
    color: $foreground;
}

#scoreboard-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- shop ----------------------------------------------------------------- */

ShopScreen {
    align: center middle;
    background: $background 70%;
}

#shop {
    width: 74;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#shop-title {
    width: 1fr;
    height: auto;
    text-style: bold;
    color: $accent;
}

#shop-gold {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
}

/* Capped and scrollable: the shelves grew past a terminal's height. The
   scrollbar is hidden for the same reason the message log's is -- it would take
   a column out of the detail text, and the hint already says how to move. */
#shop-list {
    width: 1fr;
    height: auto;
    max-height: 20;
    scrollbar-size-vertical: 0;
}

#shop-rows {
    width: 1fr;
    height: auto;
}

#shop-message {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    color: $text-muted;
}

#shop-hint {
    width: 1fr;
    height: auto;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- spring -------------------------------------------------------------- */

SpringScreen {
    align: center middle;
    background: $background 70%;
}

#spring {
    width: 62;
    height: auto;
    padding: 1 2;
    border: round #2ee6a8;
    background: $surface;
}

#spring-title {
    width: 1fr;
    height: auto;
    text-style: bold;
    color: #2ee6a8;
}

#spring-body {
    width: 1fr;
    height: auto;
    margin: 1 0 1 0;
}

#spring-hint {
    width: 1fr;
    height: auto;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- inventory ----------------------------------------------------------- */

InventoryScreen {
    align: center middle;
    background: $background 70%;
}

#inventory {
    /* Wide enough for the longest description beside the longest name: an
       amulet's ability is a sentence, and a wrapped sentence in a column reads
       as a mistake. It is a modal, so width is the cheap dimension. */
    width: 80;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $panel;
    background: $surface;
}

#inventory-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    text-style: bold;
    color: $accent;
}

#inventory-body {
    width: 1fr;
    height: auto;
}

#inventory-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    color: #6b6b6b;
}

/* -- somebody talking ---------------------------------------------------- */

NpcScreen {
    align: center middle;
    background: $background 70%;
}

#npc {
    width: 60;
    height: auto;
    padding: 1 2;
    border: round $panel;
    background: $surface;
}

#npc-title {
    width: 1fr;
    height: auto;
    text-style: bold;
    color: $accent;
}

#npc-body {
    width: 1fr;
    height: auto;
    margin: 1 0 1 0;
}

#npc-hint {
    width: 1fr;
    height: auto;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- a page of the chronicle --------------------------------------------- */

#page {
    /* Wider than a chest and narrower than the book: this is a page of prose,
       and prose needs a measure. The max keeps a long fragment -- they run to
       ninety-seven words -- from running off a short terminal. */
    width: 76;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round #8a9ba8;
    background: $surface;
}

#page-title {
    width: 1fr;
    height: auto;
    content-align: center middle;
    text-style: bold;
    color: #e8e8e0;
}

#page-subtitle {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    content-align: center middle;
    color: #8a9ba8;
}

#page-body {
    width: 1fr;
    height: auto;
    margin: 1 0 1 0;
    /* The prologue's prose colour: just off white, so it reads as remembered
       rather than reported. A page of the chronicle is the same kind of
       writing, and full-brightness text in a dark panel reads as a form. */
    color: #c8c8c8;
}

#page-hint {
    width: 1fr;
    height: auto;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- chest --------------------------------------------------------------- */

ChestScreen {
    align: center middle;
    background: $background 70%;
}

#chest {
    width: 64;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

#chest-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    content-align: center middle;
    text-style: bold;
    color: $warning;
}

#chest-body {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    color: $foreground;
}

#chest-hint {
    width: 1fr;
    height: auto;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- prologue ------------------------------------------------------------ */

#prologue-screen {
    /* Auto rather than a percentage: the pane is exactly as tall as the story,
       so a short prologue does not float in a mostly-empty box. The max keeps a
       very long story from running off the screen entirely. */
    width: 76;
    height: auto;
    max-height: 95%;
    padding: 1 3;
    background: $surface 90%;
}

#prologue-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    content-align: center middle;
    text-style: bold;
    color: $error;
}

#prologue-screen .prologue-line {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    /* Just off white. The prose is meant to read as remembered rather than
       reported, and full-brightness text in a dark panel reads as a form. */
    color: #c8c8c8;
}

/* The line the player is meant to leave with, so it is set apart from the story
   above it rather than being one more paragraph. */
#prologue-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    text-style: bold italic;
    color: $accent;
}

#prologue-dismiss {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- game over / pause ------------------------------------------------- */

/* Both modals share a shape; only the accent differs. */
#game-over, #pause {
    align: center middle;
    width: auto;
    max-width: 80%;
    height: auto;
    padding: 1 3;
    background: $background 85%;
    border: round $panel;
}

#game-over-title {
    width: 1fr;
    content-align: center middle;
    text-style: bold;
    color: $error;
}

#pause-title {
    width: 1fr;
    content-align: center middle;
    text-style: bold;
    color: $warning;
}

#game-over-body, #pause-body {
    width: 42;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
}

#game-over-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}
