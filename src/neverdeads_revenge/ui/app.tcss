/* Neverdead's Revenge -- visual theme.
   Dark, cold and readable at a glance: the dungeon should feel like a place you
   are looking into, not a page of text.

   Only real Textual design tokens are used here (accent, background, border,
   error, foreground, panel, primary, secondary, success, surface, text,
   warning). Dimmed text uses literal greys, because there is no muted/dim token. */

Screen {
    background: $background;
    color: $foreground;
}

/* -- title ------------------------------------------------------------- */

#title-screen {
    align: center middle;
    height: 1fr;
}

#title-art {
    width: 1fr;
    content-align: center middle;
    color: $accent;
    text-style: bold;
}

#title-subtitle {
    width: 1fr;
    content-align: center middle;
    color: #8f8f8f;
}

#title-version, #title-hint {
    width: 1fr;
    content-align: center middle;
    color: #6b6b6b;
}

/* Blank until there has been a run, so it is styled but usually empty. */
#title-best {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: $accent;
}

/* -- hero select ------------------------------------------------------- */

#hero-select {
    align: center middle;
    width: 1fr;
    height: 1fr;
}

/* The glyph the player is about to become. Wide enough for one character plus
   its padding so the name beside it does not shift when the hero changes. */
#hero-glyph {
    width: 4;
    height: auto;
    content-align: center middle;
}

#hero-name {
    width: auto;
    content-align: left middle;
    color: $accent;
    text-style: bold;
}

#hero-title {
    width: auto;
    padding: 0 0 0 1;
    content-align: left middle;
    color: #8f8f8f;
}

#hero-blurb {
    width: 56;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
}

#hero-stats {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
}

#hero-roster {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}

#hero-roster-hint {
    width: 1fr;
    height: auto;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- game screen ------------------------------------------------------- */

#game-screen {
    layout: vertical;
}

#game-body {
    height: 1fr;
}

#map-view {
    width: 1fr;
    height: 1fr;
    border: round $panel;
    padding: 0 1;
}

#sidebar {
    /* Wide enough for the longest legend line: "skeleton even 28hp 6-12d". */
    width: 34;
    height: 1fr;
    border: round $panel;
    padding: 0 1;
    layout: vertical;
}

/* The log sits under the map, full width, at a fixed height. The map above it
   takes whatever is left, which is why the legend lives in the sidebar instead
   of beside the log: a bottom-row legend leaves the map about ten rows to work
   with, and the map is the thing that needs the rows.

   Six, not seven: the legend gained the chest row and the sidebar needed the
   line back. The log still shows the last four messages, which is what a fight
   needs. */
#message-log {
    width: 1fr;
    height: 6;
    min-height: 4;
    border: round $panel;
    padding: 0 1;
    background: $surface;
    /* No scrollbar. It is a tail view -- the newest lines, auto-scrolled -- and
       the keys belong to the game, so a bar implying you can scroll it is a
       decoration that only invites the question of what it is for. */
    scrollbar-size-vertical: 0;
}

/* -- help ---------------------------------------------------------------- */

HelpScreen {
    align: center middle;
    background: $background 70%;
}

#help {
    width: 76;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $panel;
    background: $surface;
}

#help-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    text-style: bold;
    color: $accent;
}

#help-body {
    width: 1fr;
    height: auto;
    color: $foreground;
}

#help-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- character sheet ----------------------------------------------------- */

CharacterScreen {
    align: center middle;
    background: $background 70%;
}

#character {
    width: 60;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $panel;
    background: $surface;
}

#character-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    text-style: bold;
    color: $accent;
}

#character-body {
    width: 1fr;
    height: auto;
    color: $foreground;
}

#character-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- name entry / scoreboard --------------------------------------------- */

NameEntryScreen, ScoreboardScreen {
    align: center middle;
    background: $background 70%;
}

#name-entry {
    width: 44;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#name-entry-title {
    width: 1fr;
    height: auto;
    content-align: center middle;
    text-style: bold;
    color: $accent;
}

#name-entry-score {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    content-align: center middle;
    color: #8f8f8f;
}

#name-entry-slots {
    width: 1fr;
    height: auto;
    margin: 1 0 1 0;
    content-align: center middle;
    text-style: bold;
}

#name-entry-hint {
    width: 1fr;
    height: auto;
    content-align: center middle;
    color: #6b6b6b;
}

#scoreboard {
    width: 60;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $panel;
    background: $surface;
}

#scoreboard-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    text-style: bold;
    color: $accent;
}

#scoreboard-body {
    width: 1fr;
    height: auto;
    color: $foreground;
}

#scoreboard-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- chest --------------------------------------------------------------- */

ChestScreen {
    align: center middle;
    background: $background 70%;
}

#chest {
    width: 64;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

#chest-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    content-align: center middle;
    text-style: bold;
    color: $warning;
}

#chest-body {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    color: $foreground;
}

#chest-hint {
    width: 1fr;
    height: auto;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- prologue ------------------------------------------------------------ */

#prologue-screen {
    /* Auto rather than a percentage: the pane is exactly as tall as the story,
       so a short prologue does not float in a mostly-empty box. The max keeps a
       very long story from running off the screen entirely. */
    width: 76;
    height: auto;
    max-height: 95%;
    padding: 1 3;
    background: $surface 90%;
}

#prologue-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    content-align: center middle;
    text-style: bold;
    color: $error;
}

#prologue-screen .prologue-line {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    /* Just off white. The prose is meant to read as remembered rather than
       reported, and full-brightness text in a dark panel reads as a form. */
    color: #c8c8c8;
}

/* The line the player is meant to leave with, so it is set apart from the story
   above it rather than being one more paragraph. */
#prologue-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    text-style: bold italic;
    color: $accent;
}

#prologue-dismiss {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- game over / pause ------------------------------------------------- */

/* Both modals share a shape; only the accent differs. */
#game-over, #pause {
    align: center middle;
    width: auto;
    max-width: 80%;
    height: auto;
    padding: 1 3;
    background: $background 85%;
    border: round $panel;
}

#game-over-title {
    width: 1fr;
    content-align: center middle;
    text-style: bold;
    color: $error;
}

#pause-title {
    width: 1fr;
    content-align: center middle;
    text-style: bold;
    color: $warning;
}

#game-over-body, #pause-body {
    width: 42;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
}

#game-over-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}
