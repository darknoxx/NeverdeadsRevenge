/* Neverdead's Revenge -- visual theme.
   Dark, cold and readable at a glance: the dungeon should feel like a place you
   are looking into, not a page of text.

   Only real Textual design tokens are used here (accent, background, border,
   error, foreground, panel, primary, secondary, success, surface, text,
   warning). Dimmed text uses literal greys, because there is no muted/dim token. */

Screen {
    background: $background;
    color: $foreground;
}

/* -- title ------------------------------------------------------------- */

#title-screen {
    align: center middle;
    height: 1fr;
}

#title-art {
    width: 1fr;
    content-align: center middle;
    color: $accent;
    text-style: bold;
}

#title-subtitle {
    width: 1fr;
    content-align: center middle;
    color: #8f8f8f;
}

#title-version, #title-hint {
    width: 1fr;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- hero select ------------------------------------------------------- */

#hero-select {
    align: center middle;
    width: 1fr;
    height: 1fr;
}

#hero-name {
    width: 1fr;
    content-align: center middle;
    color: $accent;
    text-style: bold;
}

#hero-title {
    width: 1fr;
    content-align: center middle;
    color: #8f8f8f;
}

#hero-blurb {
    width: 56;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
}

#hero-stats {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
}

#hero-locked {
    width: 1fr;
    height: auto;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- game screen ------------------------------------------------------- */

#game-screen {
    layout: vertical;
}

#game-body {
    height: 1fr;
}

#map-view {
    width: 1fr;
    height: 1fr;
    border: round $panel;
    padding: 0 1;
}

#sidebar {
    /* Wide enough for the longest legend line: "skeleton even 28hp 6-12d". */
    width: 34;
    height: 1fr;
    border: round $panel;
    padding: 0 1;
    layout: vertical;
}

/* The log sits under the map, full width, at a fixed height. The map above it
   takes whatever is left, which is why the legend lives in the sidebar instead
   of beside the log: a bottom-row legend leaves the map about ten rows to work
   with, and the map is the thing that needs the rows. */
#message-log {
    width: 1fr;
    height: 7;
    min-height: 4;
    border: round $panel;
    padding: 0 1;
    background: $surface;
}

/* -- help ---------------------------------------------------------------- */

HelpScreen {
    align: center middle;
    background: $background 70%;
}

#help {
    width: 76;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $panel;
    background: $surface;
}

#help-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    text-style: bold;
    color: $accent;
}

#help-body {
    width: 1fr;
    height: auto;
    color: $foreground;
}

#help-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- prologue ------------------------------------------------------------ */

#prologue-screen {
    width: 72;
    height: 80%;
    padding: 1 2;
    background: $surface 90%;
}

#prologue-title {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    content-align: center middle;
    text-style: bold;
    color: $error;
}

#prologue-screen .prologue-line {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    color: $foreground;
}

#prologue-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}

/* -- game over / pause ------------------------------------------------- */

/* Both modals share a shape; only the accent differs. */
#game-over, #pause {
    align: center middle;
    width: auto;
    max-width: 80%;
    height: auto;
    padding: 1 3;
    background: $background 85%;
    border: round $panel;
}

#game-over-title {
    width: 1fr;
    content-align: center middle;
    text-style: bold;
    color: $error;
}

#pause-title {
    width: 1fr;
    content-align: center middle;
    text-style: bold;
    color: $warning;
}

#game-over-body, #pause-body {
    width: 42;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
}

#game-over-hint {
    width: 1fr;
    height: auto;
    margin: 1 0 0 0;
    content-align: center middle;
    color: #6b6b6b;
}
